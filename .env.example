# Required for account + encrypted service secrets
DATABASE_URL=postgres://dasharr:dasharr@127.0.0.1:5432/dasharr

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_KEY=

# Public URL of this app (used for auth cookies / redirects)
BETTER_AUTH_URL=http://localhost:8787

# One-time bootstrap token for creating the first admin account
SETUP_TOKEN=change-me-setup-token

# Comma-separated browser origins allowed to call the API (dev UI + prod)
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8787
